#!/usr/bin/env bash
set -euo pipefail

# power_state - Display power adapter connection status
# Shows ⚡︎ when charging, blank when on battery

if [[ $OSTYPE == 'linux-gnu' ]]; then
  sed 's/1/⚡︎/g; s/0/  /g' < /sys/class/power_supply/ACAD/online
elif [[ $OSTYPE == darwin* ]]; then
  echo "<Not yet implemented>"
fi
