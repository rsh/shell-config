#!/bin/bash
set -euo pipefail

# Periodically save scrollback for specific applications
# Reads list of applications from ~/.config/tmux-save-scrollback/commands_to_save.conf
# Appends new lines with ISO8601 timestamps, detecting contiguity

# Start timing the script execution
SCRIPT_START_TIME=$(date +%s.%N)

# Configuration file containing list of commands (one per line)
CONFIG_FILE="$HOME/.config/tmux-save-scrollback/commands_to_save.conf"

# Directory to store scrollback files
SCROLLBACK_DIR="${TMUX_SCROLLBACK_DIR:-$HOME/.tmux-scrollback}"
mkdir -p "$SCROLLBACK_DIR"

# Log directory and file
LOG_DIR="$SCROLLBACK_DIR/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/execution.log"

# State and lock files
STATE_FILE="$SCROLLBACK_DIR/.state"
LOCK_FILE="$SCROLLBACK_DIR/.lock"
TEMP_DIR="$SCROLLBACK_DIR/.tmp"
mkdir -p "$TEMP_DIR"

# Acquire lock to ensure only one instance runs
exec 200>"$LOCK_FILE"
flock -n 200 || exit 0

# Function to log execution time on exit
log_execution_time() {
    local end_time
    local duration
    local timestamp
    end_time=$(date +%s.%N)
    duration=$(echo "$end_time - $SCRIPT_START_TIME" | bc)
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] Execution time: ${duration}s" >> "$LOG_FILE"
}

# Cleanup temp files on exit and log execution time
trap 'rm -rf "$TEMP_DIR"/*; flock -u 200; log_execution_time' EXIT

# If no config file exists, exit
if [ ! -f "$CONFIG_FILE" ]; then
    exit 0
fi

# Read commands to track into an array
declare -a TRACKED_COMMANDS
while IFS= read -r cmd || [ -n "$cmd" ]; do
    # Skip empty lines and comments
    # -z checks if line is empty
    # =~ regex matches lines starting with optional whitespace then #
    # If either condition is true, continue to next line
    [[ -z "$cmd" || "$cmd" =~ ^[[:space:]]*# ]] && continue
    TRACKED_COMMANDS+=("$cmd")
done < "$CONFIG_FILE"

# If no commands to track, exit
if [ ${#TRACKED_COMMANDS[@]} -eq 0 ]; then
    exit 0
fi

# Load existing state into associative array
# Format: pane_id|pid -> command|start_timestamp
declare -A STATE
if [ -f "$STATE_FILE" ]; then
    while IFS='|' read -r pane_id pid command start_ts; do
        STATE["${pane_id}|${pid}"]="${command}|${start_ts}"
    done < "$STATE_FILE"
fi

# Track current active panes to detect closed ones
declare -A ACTIVE_PANES

# Function to strip timestamps from saved file
# Returns raw content without timestamps
strip_timestamps() {
    local file="$1"
    # Remove ISO8601 timestamp prefix: YYYY-MM-DDTHH:MM:SS: or [non-contiguous] YYYY-MM-DDTHH:MM:SS:
    # Use awk for faster processing than sed
    awk '{sub(/^(\[non-contiguous\] )?[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}: /, ""); print}' "$file"
}

# Function to compute hash of last N lines of a file
# Much faster than comparing line-by-line
compute_tail_hash() {
    local file="$1"
    local num_lines="$2"
    tail -n "$num_lines" "$file" 2>/dev/null | md5sum | cut -d' ' -f1
}

# Function to find longest suffix of old content in new capture using hashing
# Returns line number in new capture where the match starts (0-indexed)
# Returns -1 if no good match found
find_suffix_match() {
    local old_file="$1"
    local new_file="$2"
    local min_match_lines=5  # Minimum lines to consider a good match
    local old_lines
    local new_lines
    old_lines=$(wc -l < "$old_file")
    new_lines=$(wc -l < "$new_file")

    # Early exit if files are too small
    if [ "$old_lines" -lt "$min_match_lines" ] || [ "$new_lines" -lt "$min_match_lines" ]; then
        echo "-1"
        return 1
    fi

    # Try progressively smaller suffixes using hash comparison
    # Start with reasonable chunk sizes to avoid too many iterations
    local check_sizes=()

    # Generate check points: full, 3/4, 1/2, 1/4, then every 100 lines down to min
    check_sizes+=("$old_lines")
    [ "$old_lines" -gt "$min_match_lines" ] && check_sizes+=($((old_lines * 3 / 4)))
    [ "$old_lines" -gt "$min_match_lines" ] && check_sizes+=($((old_lines / 2)))
    [ "$old_lines" -gt "$min_match_lines" ] && check_sizes+=($((old_lines / 4)))

    for ((i=old_lines-100; i>=min_match_lines; i-=100)); do
        check_sizes+=("$i")
    done
    check_sizes+=("$min_match_lines")

    for suffix_len in "${check_sizes[@]}"; do
        [ "$suffix_len" -lt "$min_match_lines" ] && continue
        [ "$suffix_len" -gt "$old_lines" ] && continue

        # Get hash of old suffix
        local old_hash
        local new_hash
        old_hash=$(compute_tail_hash "$old_file" "$suffix_len")

        # Check if this suffix appears at the end of new content
        if [ "$suffix_len" -le "$new_lines" ]; then
            new_hash=$(compute_tail_hash "$new_file" "$suffix_len")

            if [ "$old_hash" = "$new_hash" ]; then
                # Found a match! Return the line number where new content starts
                echo "$new_lines"
                return 0
            fi
        fi
    done

    # No match found
    echo "-1"
    return 1
}

# Get current timestamp in ISO8601 format (cached for the script run)
CACHED_TIMESTAMP=""
get_timestamp() {
    if [ -z "$CACHED_TIMESTAMP" ]; then
        CACHED_TIMESTAMP=$(date -Iseconds | cut -d'+' -f1 | cut -d'-' -f1-3)
    fi
    echo -n "$CACHED_TIMESTAMP"
}

# Find all tmux server sockets
TMUX_TMPDIR="${TMUX_TMPDIR:-/tmp}"
SOCKET_DIR="$TMUX_TMPDIR/tmux-$(id -u)"

# Array to hold all server sockets
declare -a SERVERS

if [ -d "$SOCKET_DIR" ]; then
    # Find all socket files in the tmux directory
    while IFS= read -r socket; do
        SERVERS+=("$socket")
    done < <(find "$SOCKET_DIR" -type s 2>/dev/null)
fi

# If no sockets found, try the default tmux server
if [ ${#SERVERS[@]} -eq 0 ]; then
    # Check if default server has sessions
    if tmux list-sessions &>/dev/null; then
        SERVERS+=("default")
    fi
fi

# Process each tmux server
for SERVER in "${SERVERS[@]}"; do
    # Set tmux command based on socket type
    if [ "$SERVER" = "default" ]; then
        TMUX_CMD="tmux"
    else
        TMUX_CMD="tmux -S $SERVER"
    fi

    # Get list of all sessions for this server
    SESSIONS=$($TMUX_CMD list-sessions -F "#{session_name}" 2>/dev/null)

    if [ -n "$SESSIONS" ]; then
        # Iterate through each session
        for SESSION in $SESSIONS; do
            # Get all windows in this session
            WINDOWS=$($TMUX_CMD list-windows -t "$SESSION" -F "#{window_index}" 2>/dev/null)

            for WINDOW in $WINDOWS; do
                # Get all panes in this window with their commands and PIDs
                # Use process substitution to avoid subshell from pipeline
                while IFS='|' read -r PANE_ID PANE_PID PANE_COMMAND; do

                # Check if this command should be tracked
                SHOULD_TRACK=false
                for tracked_cmd in "${TRACKED_COMMANDS[@]}"; do
                    if [[ "$PANE_COMMAND" == "$tracked_cmd" ]] || [[ "$PANE_COMMAND" == "$tracked_cmd "* ]]; then
                        SHOULD_TRACK=true
                        break
                    fi
                done

                if [ "$SHOULD_TRACK" = true ]; then
                    # Mark as active
                    ACTIVE_PANES["${PANE_ID}|${PANE_PID}"]=1

                    # Check if this is a new process
                    if [ -z "${STATE[${PANE_ID}|${PANE_PID}]}" ]; then
                        # New process - record start time
                        START_TS=$(date +%Y%m%d_%H%M%S)
                        STATE["${PANE_ID}|${PANE_PID}"]="${PANE_COMMAND}|${START_TS}"
                    fi

                    # Get the command and start timestamp for this process
                    IFS='|' read -r SAVED_COMMAND START_TS <<< "${STATE[${PANE_ID}|${PANE_PID}]}"

                    # Create filename based on command and start time
                    FILENAME="${SAVED_COMMAND}-${START_TS}.txt"
                    FILEPATH="$SCROLLBACK_DIR/$FILENAME"

                    # Capture current scrollback to temp file
                    TEMP_NEW="$TEMP_DIR/new_$$_${PANE_ID//[^a-zA-Z0-9]/_}"
                    $TMUX_CMD capture-pane -t "$PANE_ID" -pS - 2>/dev/null > "$TEMP_NEW"

                    if [ -f "$FILEPATH" ]; then
                        # File exists - need to find what's new
                        TEMP_OLD_STRIPPED="$TEMP_DIR/old_stripped_$$_${PANE_ID//[^a-zA-Z0-9]/_}"

                        # Strip timestamps from existing file (only once per pane)
                        strip_timestamps "$FILEPATH" > "$TEMP_OLD_STRIPPED"

                        # Find where old content matches in new capture
                        match_line=$(find_suffix_match "$TEMP_OLD_STRIPPED" "$TEMP_NEW")

                        CURRENT_TS=$(get_timestamp)

                        if [ "$match_line" -ge 0 ]; then
                            # Found contiguous match - append only new lines
                            new_start=$((match_line + 1))
                            total_lines=$(wc -l < "$TEMP_NEW")

                            if [ "$new_start" -le "$total_lines" ]; then
                                # There are new lines to add
                                # Use awk for faster processing instead of while read loop
                                tail -n +"$new_start" "$TEMP_NEW" | awk -v ts="$CURRENT_TS" '{print ts ": " $0}' >> "$FILEPATH"
                            fi
                        else
                            # No match found - content is non-contiguous
                            # This could mean scrollback cycled, screen was cleared, or content changed
                            # Just mark the discontinuity; don't duplicate the entire buffer
                            echo "[non-contiguous - scrollback may have cycled at ${CURRENT_TS}]" >> "$FILEPATH"
                        fi

                        rm -f "$TEMP_OLD_STRIPPED"
                    else
                        # New file - add timestamps to all lines
                        # Use awk for faster processing instead of while read loop
                        CURRENT_TS=$(get_timestamp)
                        awk -v ts="$CURRENT_TS" '{print ts ": " $0}' "$TEMP_NEW" > "$FILEPATH"
                    fi

                    rm -f "$TEMP_NEW"
                fi
            done < <($TMUX_CMD list-panes -t "${SESSION}:${WINDOW}" -F "#{pane_id}|#{pane_pid}|#{pane_current_command}" 2>/dev/null)
        done
    done
    fi
done

# Clean up state for processes that are no longer running
declare -A NEW_STATE
for key in "${!STATE[@]}"; do
    if [ -n "${ACTIVE_PANES[$key]}" ]; then
        NEW_STATE[$key]="${STATE[$key]}"
    fi
done

# Write new state file
true > "$STATE_FILE"
for key in "${!NEW_STATE[@]}"; do
    IFS='|' read -r pane_id pid <<< "$key"
    IFS='|' read -r command start_ts <<< "${NEW_STATE[$key]}"
    echo "${pane_id}|${pid}|${command}|${start_ts}" >> "$STATE_FILE"
done
