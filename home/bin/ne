#!/usr/bin/python3

import datetime
import os
import re
import sys
import tempfile
import shutil


def append_date_and_start_vim(filename, prepend_newlines=False):
    # Read the file if it exists, otherwise start with empty content
    if os.path.exists(filename):
        with open(filename, 'r') as f:
            content = f.read()
        # Remove all trailing whitespace and newlines
        content = content.rstrip()
    else:
        content = ""

    prepend_str = "\n\n" if prepend_newlines else ""

    date_and_time_str = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')

    # Write to a temporary file first, then rename atomically
    fd, temp_path = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(filename)) or '.', prefix='.tmp_', suffix='.md')
    try:
        with os.fdopen(fd, 'w') as f:
            if content:
                f.write(content)
            f.write(f"{prepend_str}## {date_and_time_str}\n\n\n")
        shutil.move(temp_path, filename)
    except:
        os.unlink(temp_path)
        raise

    os.system(f'nvim +$ +startinsert {filename}')

note_name_input = 'scratchpad'
if len(sys.argv) > 1:
    note_name_input = sys.argv[1]

# If filename ends with .md, use it as-is (exact filename)
if note_name_input.endswith('.md'):
    filename = note_name_input
    prepend_newlines = os.path.exists(filename)
    append_date_and_start_vim(filename, prepend_newlines=prepend_newlines)
else:
    # For non-.md inputs, use dated filename
    date_str = datetime.datetime.now().strftime('%Y-%m-%d')
    dated_filename = f"{date_str}_{note_name_input}.md"

    if os.path.exists(dated_filename): # Check if dated version exists
        filename = dated_filename
        append_date_and_start_vim(filename, prepend_newlines=True)
    else: # it's a new note
        filename = dated_filename
        append_date_and_start_vim(filename)
