# Example configuration for tmux scrollback auto-save
# Copy this file to commands_to_save.conf and customize for your needs
#
# List one command per line - any tmux pane running these commands
# will have its scrollback automatically saved periodically.
#
# Empty lines and lines starting with # are ignored.

# Development tools
python
node
npm
cargo

# System monitoring
htop
top
glances

# Build/compilation
make
cmake
gcc

# Interactive shells (be careful - may generate large logs)
# bash
# zsh

# Add your own commands below:
